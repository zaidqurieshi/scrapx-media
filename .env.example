# ==============================================================================
# Telegram News Forwarding Automation — ScrapX Media
# Environment Configuration
# ==============================================================================

# Telegram API credentials (obtain from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Session name for local Telethon session storage (.session file)
TELEGRAM_SESSION_NAME=scrapx_session

# Source Channels (Can be @username, channel link, or channel ID like -100123456789)
FIRST_SQUAWK_CHANNEL=@FirstSquawk
FAYTUKS_NETWORK_CHANNEL=@faytuks

# Destination Channel (Can be @username, channel link, or channel ID)
SCRAPX_MEDIA_CHANNEL=@ScrapXMedia

# Channel Source Enable / Disable Toggles
ENABLE_FIRST_SQUAWK=true
ENABLE_FAYTUKS=true

# Execution Modes
# If DRY_RUN=true, messages will be captured and transformed, but NOT published to ScrapX Media.
DRY_RUN=false

# Media Group / Album debouncing window in seconds
MEDIA_GROUP_DEBOUNCE_SECONDS=1.5

# Database path for persistent deduplication
DATABASE_PATH=data/scrapx_media.db

# Logging Configuration (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

